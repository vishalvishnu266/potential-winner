{
  "name": "ota-demo-capacitor",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build:leptos": "cd ../leptos-app && trunk build --release",
    "bundle": "node scripts/make-bundle.mjs",
    "sync": "npm run build:leptos && npx cap sync android",
    "android": "npm run sync && npx cap run android",
    "ota": "npm run bundle"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.0",
    "@capacitor/core": "^6.1.0",
    "@capacitor/haptics": "^6.0.0",
    "@capawesome/capacitor-live-update": "^6.4.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "adm-zip": "^0.5.16",
    "typescript": "^5.5.4"
  }
}
