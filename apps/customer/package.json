{
  "name": "@app/customer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "APP_ENV=dev APP_NAME=customer vite",
    "build": "tsc --noEmit && APP_ENV=dev APP_NAME=customer vite build",
    "build:dev": "tsc --noEmit && APP_ENV=dev APP_NAME=customer vite build",
    "build:prod": "tsc --noEmit && APP_ENV=prod APP_NAME=customer vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "android": "npm run build:dev && npx cap sync android && npx cap run android",
    "ios": "npm run build:dev && npx cap sync ios && npx cap open ios",
    "bundle:ota": "APP_ENV=dev node ../../scripts/build-bundle.mjs --app=customer",
    "bundle:ota:prod": "APP_ENV=prod node ../../scripts/build-bundle.mjs --app=customer"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/preferences": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.0",
    "@capgo/capacitor-updater": "^8.51.3",
    "@hey-api/openapi-ts": "0.99.0",
    "@pkg/api-contracts": "*",
    "@pkg/i18n": "*",
    "@pkg/native": "*",
    "@pkg/ota": "*",
    "@pkg/theme": "*",
    "@pkg/ui": "*",
    "@pkg/vite-config": "*",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^8.2.0"
  }
}
