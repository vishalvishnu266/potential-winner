{
  "name": "task-platform",
  "private": true,
  "version": "0.0.0",
  "description": "Two-app platform: customer (post work / find cabs) + worker (freelancer & service-firm ops). Shares a Rust/Axum backend and OTA pipeline.",
  "workspaces": [
    "task-app-native"
  ],
  "scripts": {
    "//dev": "── ONE command runs everything: Rust server + dev native app ──",
    "dev":                  "concurrently -n server,native -c cyan,magenta \"npm:server\" \"npm:dev:native\"",
    "dev:native":           "echo 'Vanilla JS native app dev mode'",

    "//server": "── Rust backend on its own ──",
    "server":               "cd server && cargo run --bin server",

    "//build": "── Finalize (native app) ──",
    "build":                "npm run build --workspace task-app-native",
    "verify":               "npm run build",

    "//native": "── Native (Capacitor) — sync + run ──",
    "sync:native":          "npm run sync --workspace task-app-native",
    "android:native":       "npm run android --workspace task-app-native",
    "ios:native":           "npm run ios --workspace task-app-native",

    "//release": "── One-shot OTA release ──",
    "release:ota:native":   "npm run bundle:ota --workspace task-app-native"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3"
  }
}
